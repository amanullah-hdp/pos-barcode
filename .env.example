# Database (recommended: project-local for dev)
BARCODE_POS_DB=./data/pos.sqlite

# Production — required when NODE_ENV=production
BARCODE_POS_PIN=change-me-to-a-strong-pin
BARCODE_POS_SECRET=use-a-long-random-string-at-least-16-chars

# Optional
# HOST=127.0.0.1
# PORT=3001
# BARCODE_POS_CORS_ORIGIN=http://127.0.0.1:5173
# BARCODE_POS_OPEN_PRICE_MAX_CENTS=50000000
# BARCODE_POS_SEED_CONFIRM=1
